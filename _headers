# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
# Note: Pages applies EVERY matching rule and concatenates the values, so the
# path patterns below must not overlap, or Cache-Control ends up duplicated.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()

# HTML has no fingerprint in its name, so it must always be revalidated.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Generated derivatives never change under these names. Replacing one means
# renaming it, so these are safe to cache permanently.
/img/opt/*
  Cache-Control: public, max-age=31536000, immutable

# Original sources — one month.
/img/garden1.jpg
  Cache-Control: public, max-age=2592000
/img/garden2.jpg
  Cache-Control: public, max-age=2592000
/img/garden3.jpg
  Cache-Control: public, max-age=2592000
/logo.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000
