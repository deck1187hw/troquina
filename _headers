# Cloudflare Pages headers — https://developers.cloudflare.com/pages/configuration/headers/
#
# Pages applies EVERY matching rule and concatenates values, so path patterns
# below must not overlap or Cache-Control ends up duplicated.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML carries no fingerprint in its name, so the browser must always
# revalidate. The CDN still caches it and serves instantly on a hit.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/gl/
  Cache-Control: public, max-age=0, must-revalidate
/en/
  Cache-Control: public, max-age=0, must-revalidate

# Generated derivatives never change under these names — replacing one means
# renaming it — so they are safe to cache for a year and never revalidate.
/img/opt/*
  Cache-Control: public, max-age=31536000, immutable

# Original source images: one year, but revalidated rather than immutable,
# since these are the files a human would overwrite in place.
/img/garden1.jpg
  Cache-Control: public, max-age=31536000
/img/garden2.jpg
  Cache-Control: public, max-age=31536000
/img/garden3.jpg
  Cache-Control: public, max-age=31536000
/garden.jpg
  Cache-Control: public, max-age=31536000
/logo.png
  Cache-Control: public, max-age=31536000
/apple-touch-icon.png
  Cache-Control: public, max-age=31536000

# Crawler files change rarely but must not go stale for long.
/robots.txt
  Cache-Control: public, max-age=86400
/sitemap.xml
  Cache-Control: public, max-age=86400

